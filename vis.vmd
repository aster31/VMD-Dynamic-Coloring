# Config
set gro_file "out.gro"
set xtc_file "out.xtc"
set data_path "data.npy"

# Open molecule
# Note: the ; list silences noise when loaded with vmd -e vis.vmd
mol new $gro_file; list
mol addfile $xtc_file waitfor all; list
animate delete beg 0 end 0 skip 0 0

# Loading and setting the data to "User"
source loader.tcl
load_into_user $data_path

# Visualization details - VDW, hide cluster 0
mol modstyle 0 0 VDW 2.0 12.0
mol modselect 0 0 user > 0

# Bonus: hotkeys to move inside the palette
set minmax_i 0

proc inc_pos {} {
	global minmax_i
	incr minmax_i
	if {$minmax_i > 0} {
		set minmax_i 0
	}
	mol scaleminmax 0 0 $minmax_i [expr {$minmax_i+1023}]
}
proc dec_pos {} {
	global minmax_i
	set minmax_i [expr {$minmax_i-1}]
	if {$minmax_i < -1022} {
		set minmax_i -1022
	}
	mol scaleminmax 0 0 $minmax_i [expr {$minmax_i+1023}]
}
user add key \{ dec_pos
user add key \} inc_pos
